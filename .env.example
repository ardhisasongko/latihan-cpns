# SQLite lokal untuk `next dev` (tanpa binding D1).
# PENTING: Prisma CLI me-resolve path relatif terhadap folder prisma/,
# sedangkan runtime (libsql adapter) me-resolve terhadap CWD project.
# Pakai path relatif eksplisit seperti ini agar keduanya menunjuk file yang sama.
DATABASE_URL="file:../dev.db"

# Generate: openssl rand -base64 32
AUTH_SECRET="generate dengan: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Opsional: override domain untuk metadata (Open Graph, canonical).
# NEXT_PUBLIC_SITE_URL="https://domain-kamu.com"
