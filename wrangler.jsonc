{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latihan-cpns",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "latihan-cpns",
      "database_id": "f905ef00-7e12-4c3c-9cd9-2621e7f91bea"
    }
  ],
  // Rate Limiting binding: terdistribusi lintas isolate per lokasi Cloudflare.
  // Period dibatasi platform max 60 detik -> policy auth jadi 5x/menit.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "AUTH_TRUST_HOST": "true"
  }
}